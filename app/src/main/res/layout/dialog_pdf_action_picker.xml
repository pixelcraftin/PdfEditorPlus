<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_large"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bg_pill"
        android:alpha="0.5"
        android:layout_marginBottom="16dp"/>

    <!-- Selected PDF File Header Banner -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider"
        app:cardBackgroundColor="@color/card_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <FrameLayout
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:background="@drawable/bg_icon_red">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_file"
                    app:tint="@color/icon_red"/>
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:id="@+id/tvPickedFileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="sample_document.pdf"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/text_primary"
                    android:maxLines="1"
                    android:ellipsize="middle"/>

                <TextView
                    android:id="@+id/tvPickedFileSize"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="1.2 MB • Ready for action"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeFile"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Change"
                android:textSize="12sp"
                android:textColor="@color/primary"
                app:cornerRadius="10dp"
                style="@style/Widget.PdfEditorPlus.Button.Outlined"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Choose an Operation"
        android:textSize="16sp"
        android:fontFamily="sans-serif-bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="12dp"/>

    <!-- Actions RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPdfActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="true"
        android:overScrollMode="never" />

</LinearLayout>
