<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <!-- Main NavHost -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/navHostFragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph"/>

    <!-- Bottom Nav Container (w-70% floating pill bar) -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:layout_marginBottom="19dp"
        android:clipToPadding="false">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomNavCard"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            app:cardCornerRadius="31dp"
            app:cardElevation="12dp"
            app:cardMaxElevation="16dp"
            app:strokeWidth="1dp"
            app:strokeColor="@color/nav_card_stroke"
            android:outlineSpotShadowColor="@color/nav_shadow_spot"
            android:outlineAmbientShadowColor="@color/nav_shadow_ambient"
            app:cardBackgroundColor="@color/nav_card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="4dp"
                android:paddingEnd="4dp">

                <!-- Home -->
                <LinearLayout
                    android:id="@+id/navHome"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@android:color/transparent">
                    <ImageView
                        android:id="@+id/navHomeIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_home"
                        android:contentDescription="Home"/>
                    <TextView
                        android:id="@+id/navHomeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_home"
                        android:textSize="9sp"
                        android:textColor="@color/bottom_nav_selected"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- Tools -->
                <LinearLayout
                    android:id="@+id/navTools"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@android:color/transparent">
                    <ImageView
                        android:id="@+id/navToolsIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_tools"
                        android:contentDescription="Tools"/>
                    <TextView
                        android:id="@+id/navToolsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_tools"
                        android:textSize="9sp"
                        android:textColor="@color/bottom_nav_unselected"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- FAB Center -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center">
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/fabAdd"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_add"
                        app:backgroundTint="@color/primary"
                        app:tint="@color/on_primary"
                        app:fabSize="mini"
                        app:elevation="0dp"
                        app:pressedTranslationZ="0dp"
                        android:contentDescription="Add / Open file"/>
                </LinearLayout>

                <!-- History -->
                <LinearLayout
                    android:id="@+id/navHistory"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@android:color/transparent">
                    <ImageView
                        android:id="@+id/navHistoryIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_history"
                        android:contentDescription="History"/>
                    <TextView
                        android:id="@+id/navHistoryLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_history"
                        android:textSize="9sp"
                        android:textColor="@color/bottom_nav_unselected"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <!-- Settings -->
                <LinearLayout
                    android:id="@+id/navSettings"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@android:color/transparent">
                    <ImageView
                        android:id="@+id/navSettingsIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_nav_settings"
                        android:contentDescription="Settings"/>
                    <TextView
                        android:id="@+id/navSettingsLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/nav_settings"
                        android:textSize="9sp"
                        android:textColor="@color/bottom_nav_unselected"
                        android:fontFamily="sans-serif-medium"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
