<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootCropLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top Header Bar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cropHeaderCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="4dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/card_background"
        app:strokeWidth="1dp"
        app:strokeColor="@color/divider">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <ImageButton
                android:id="@+id/btnCropBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Back"
                app:tint="@color/text_primary"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:id="@+id/tvCropTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crop Document"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:fontFamily="sans-serif-medium"/>

                <TextView
                    android:id="@+id/tvCropPageIndicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Page 1 of 1"
                    android:textSize="11sp"
                    android:textColor="@color/accent_teal"
                    android:fontFamily="sans-serif-medium"/>

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAutoCrop"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Auto-Crop"
                android:textSize="11sp"
                android:textColor="@color/primary"
                app:cornerRadius="18dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFullCrop"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Full"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                app:cornerRadius="18dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Center Crop View -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_background"
            app:strokeWidth="1dp"
            app:strokeColor="@color/divider">

            <com.pixelcraftin.pdfeditorplus.ui.documenteditor.crop.DocumentCropView
                android:id="@+id/documentCropView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Loading / Processing indicator -->
        <ProgressBar
            android:id="@+id/cropProgressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Bottom Crop Toolbar -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cropBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="8dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:id="@+id/cropBottomContainer"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageButton
                android:id="@+id/btnCropRotate"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/ic_rotate"
                android:background="@drawable/bg_pill"
                android:padding="10dp"
                app:tint="@color/icon_teal"
                android:contentDescription="Rotate 90°"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCropPrev"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:padding="0dp"
                app:icon="@drawable/ic_chevron_left"
                app:iconSize="22dp"
                app:iconTint="@color/text_primary"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:cornerRadius="22dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:contentDescription="Previous Page"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSkipCrop"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Skip"
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="8dp"
                app:cornerRadius="20dp"
                style="@style/Widget.MaterialComponents.Button.TextButton"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextOrDone"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:padding="0dp"
                app:icon="@drawable/ic_chevron_right"
                app:iconSize="22dp"
                app:iconTint="@color/on_primary"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:cornerRadius="24dp"
                app:backgroundTint="@color/primary"
                android:contentDescription="Next Page or Apply"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
