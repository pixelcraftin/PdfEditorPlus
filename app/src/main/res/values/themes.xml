<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PdfEditorPlus" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <!-- Secondary -->
        <item name="colorSecondary">@color/accent_teal</item>
        <item name="colorOnSecondary">@color/on_primary</item>
        <!-- Background -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorOnBackground">@color/on_background</item>
        <!-- Error -->
        <item name="colorError">@color/error</item>
        <!-- Status bar / navigation bar -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Splash screen (Android 12+) -->
        <item name="android:windowSplashScreenBackground">@color/background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <!-- Shapes -->
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.PdfEditorPlus.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.PdfEditorPlus.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.PdfEditorPlus.Large</item>
        <!-- Text appearance -->
        <item name="textAppearanceHeadline4">@style/TextAppearance.PdfEditorPlus.Headline</item>
        <item name="textAppearanceBody1">@style/TextAppearance.PdfEditorPlus.Body</item>
    </style>

    <!-- Shape styles -->
    <style name="ShapeAppearance.PdfEditorPlus.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.PdfEditorPlus.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.PdfEditorPlus.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- Text appearance styles -->
    <style name="TextAppearance.PdfEditorPlus" parent="TextAppearance.MaterialComponents.Body1"/>
    <style name="TextAppearance.PdfEditorPlus.Headline" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>
    <style name="TextAppearance.PdfEditorPlus.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>

    <!-- Bottom sheet dialog theme -->
    <style name="BottomSheetDialog.PdfEditorPlus" parent="ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheet.PdfEditorPlus</item>
        <item name="android:colorBackground">@color/surface</item>
    </style>
    <style name="BottomSheet.PdfEditorPlus" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearance">@style/ShapeAppearance.PdfEditorPlus.Large</item>
        <item name="backgroundTint">@color/surface</item>
    </style>

    <!-- Tool bar title style -->
    <style name="TextAppearance.PdfEditorPlus.ToolTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Card style -->
    <style name="Widget.PdfEditorPlus.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="contentPadding">0dp</item>
    </style>

    <!-- Outlined button style -->
    <style name="Widget.PdfEditorPlus.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textColor">@color/primary</item>
        <item name="strokeColor">@color/primary</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Filled button style -->
    <style name="Widget.PdfEditorPlus.Button.Filled" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/on_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <!-- Section header text style -->
    <style name="TextAppearance.PdfEditorPlus.SectionHeader">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- Tag chip style -->
    <style name="TextAppearance.PdfEditorPlus.Tag">
        <item name="android:textSize">9sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">@color/tag_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
