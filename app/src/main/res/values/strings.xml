    <!-- About Screen -->
    <string name="about_title">About</string>
    <string name="how_it_works">How it Works</string>
    <string name="private_open_source">100% Private &amp; Open Source</string>
    <string name="about_desc">PdfEditor+ runs entirely on your device. While traditional tools force you to upload sensitive documents to their servers, our app uses an on-device, &lt;b&gt;100% open-source engine&lt;/b&gt; to process everything locally.</string>
    <string name="zero_cloud_full">&lt;b&gt;Zero Cloud:&lt;/b&gt; Your PDFs never leave your phone. Editing, signing, and merging happen locally via your phone\'s processor.</string>
    <string name="instant_offline_full">&lt;b&gt;Instant &amp; Offline:&lt;/b&gt; No internet required. Edit instantly on planes, in remote areas, or in high-security environments.</string>
    <string name="about_privacy_statement">Ultimate privacy through open-source transparency. Your data stays on your device — exactly where it belongs.</string>
